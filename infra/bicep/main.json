        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataOwnerRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('storageQueueDataContributorRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageQueueDataContributorRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('storageTableDataContributorRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageTableDataContributorRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('storageAccountContributorRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageAccountContributorRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "approval-logicapp",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "logicAppName": {
            "value": "[parameters('logicAppName')]"
          },
          "o365ConnectionName": {
            "value": "[parameters('o365ConnectionName')]"
          },
          "callbackApiBaseUrl": {
            "value": "[format('https://{0}/api', reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01').defaultHostName)]"
          },
          "callbackToken": {
            "value": "[parameters('callbackToken')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.40.2.10011",
              "templateHash": "13320279911337989415"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "defaultValue": "[resourceGroup().location]"
            },
            "logicAppName": {
              "type": "string",
              "defaultValue": "[format('la-approval-{0}', uniqueString(resourceGroup().id))]"
            },
            "o365ConnectionName": {
              "type": "string"
            },
            "callbackApiBaseUrl": {
              "type": "string"
            },
            "callbackToken": {
              "type": "securestring"
            }
          },
          "variables": {
            "$fxv#0": {
              "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
              "contentVersion": "1.0.0.0",
              "parameters": {
                "o365ConnectionName": {
                  "type": "String"
                },
                "callbackApiBaseUrl": {
                  "type": "String"
                },
                "callbackToken": {
                  "type": "SecureString"
                }
              },
              "triggers": {
                "When_an_HTTP_request_is_received": {
                  "type": "Request",
                  "kind": "Http",
                  "inputs": {
                    "schema": {
                      "type": "object",
                      "required": [
                        "approvalId",
                        "batchId",
                        "stage",
                        "deadline",
                        "riskSummary"
                      ],
                      "properties": {
                        "approvalId": {
                          "type": "string"
                        },
                        "batchId": {
                          "type": "string"
                        },
                        "stage": {
                          "type": "string",
                          "enum": [
                            "finance",
                            "engineering"
                          ]
                        },
                        "deadline": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "riskSummary": {
                          "type": "object",
                          "required": [
                            "level",
                            "score"
                          ],
                          "properties": {
                            "level": {
                              "type": "string"
                            },
                            "score": {
                              "type": "number"
                            },
                            "reasons": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "actions": {
                "Send_Finance_Approval_Email": {
                  "runAfter": {},
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('o365ConnectionName')"
                      }
                    },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "justinjoy@microsoft.com",
                      "Subject": "Finance approval required: @{triggerBody()?['batchId']}",
                      "Body": "Please review approval @{triggerBody()?['approvalId']}. Risk level: @{triggerBody()?['riskSummary']?['level']}."
                    }
                  }
                },
                "Wait_For_Finance_Decision": {
                  "type": "Http",
                  "runAfter": {
                    "Send_Finance_Approval_Email": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "method": "GET",
                    "uri": "@{concat(parameters('callbackApiBaseUrl'), '/approvals/', triggerBody()?['approvalId'], '/finance')}",
                    "headers": {
                      "x-approval-token": "@parameters('callbackToken')"
                    }
                  }
                },
                "Finance_Approved": {
                  "type": "If",
                  "runAfter": {
                    "Wait_For_Finance_Decision": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "equals": [
                      "@body('Wait_For_Finance_Decision')?['decision']",
                      "approve"
                    ]
                  },
                  "actions": {
                    "Send_Engineering_Approval_Email": {
                      "type": "ApiConnection",
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('o365ConnectionName')"
                          }
                        },
                        "method": "post",
                        "path": "/v2/Mail",
                        "body": {
                          "To": "justinjoy@microsoft.com",
                          "Subject": "Engineering approval required: @{triggerBody()?['batchId']}",
                          "Body": "Finance approved. Please review approval @{triggerBody()?['approvalId']}."
                        }
                      }
                    },
                    "Wait_For_Engineering_Decision": {
                      "type": "Http",
                      "runAfter": {
                        "Send_Engineering_Approval_Email": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "method": "GET",
                        "uri": "@{concat(parameters('callbackApiBaseUrl'), '/approvals/', triggerBody()?['approvalId'], '/engineering')}",
                        "headers": {
                          "x-approval-token": "@parameters('callbackToken')"
                        }
                      }
                    },
                    "Engineering_Approved": {
                      "type": "If",
                      "runAfter": {
                        "Wait_For_Engineering_Decision": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "equals": [
                          "@body('Wait_For_Engineering_Decision')?['decision']",
                          "approve"
                        ]
                      },
                      "actions": {
                        "Complete_Approved": {
                          "type": "Response",
                          "kind": "Http",
                          "inputs": {
                            "statusCode": 200,
                            "body": {
                              "approvalId": "@{triggerBody()?['approvalId']}",
                              "decision": "approve"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Complete_Rejected_At_Engineering": {
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                              "statusCode": 200,
                              "body": {
                                "approvalId": "@{triggerBody()?['approvalId']}",
                                "decision": "reject"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Complete_Rejected_At_Finance": {
                        "type": "Response",
                        "kind": "Http",
                        "inputs": {
                          "statusCode": 200,
                          "body": {
                            "approvalId": "@{triggerBody()?['approvalId']}",
                            "decision": "reject"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Logic/workflows",
              "apiVersion": "2019-05-01",
              "name": "[parameters('logicAppName')]",
              "location": "[parameters('location')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "state": "Enabled",
                "definition": "[variables('$fxv#0')]",
                "parameters": {
                  "o365ConnectionName": {
                    "value": "[parameters('o365ConnectionName')]"
                  },
                  "callbackApiBaseUrl": {
                    "value": "[parameters('callbackApiBaseUrl')]"
                  },
                  "callbackToken": {
                    "value": "[parameters('callbackToken')]"
                  }
                }
              }
            }
          ],
          "outputs": {
            "logicAppResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
            },
            "logicAppPrincipalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[parameters('functionAppName')]"
    },
    "functionAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2023-12-01', 'full').identity.principalId]"
    },
    "logicAppResourceId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'approval-logicapp'), '2025-04-01').outputs.logicAppResourceId.value]"
    },
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'approval-logicapp'), '2025-04-01').outputs.logicAppPrincipalId.value]"
    }
  }
}
