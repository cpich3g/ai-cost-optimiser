{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "durableTask": {
      "hubName": "CostOptimizerHub",
      "maxQueuePollingInterval": "00:00:10",
      "storageProvider": {
        "type": "AzureStorage",
        "connectionName": "AzureWebJobsStorage"
      }
    }
  },
  "functionTimeout": "00:10:00",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Triggers.DurableTask": "Warning"
    }
  }
}
